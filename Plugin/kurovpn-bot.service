[Unit]
Description=KUROVPN Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kurovpn
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/kurovpn/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
