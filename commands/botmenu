#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Telegram Bot Setup

clear
echo "========================="
echo "   Telegram Bot Setup"
echo "========================="
echo ""

read -p "Bot Token    : " TOKEN
[[ -z "$TOKEN" ]] && { echo "Token required."; exit 0; }

read -p "Admin Chat ID: " CHATID
[[ -z "$CHATID" ]] && { echo "Chat ID required."; exit 0; }

mkdir -p /etc/funny
echo "$TOKEN" > /etc/funny/.keybot
echo "$CHATID" > /etc/funny/.chatid
chmod 600 /etc/funny/.keybot /etc/funny/.chatid

echo ""
echo "Bot token and chat ID saved."
echo "To deploy the bot, copy Plugin/bot.py to /opt/kurovpn/bot.py"
echo "and enable the kurovpn-bot service."
echo ""
read -n1 -s -r -p "Press any key..."
menu
