#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Telegram Bot Setup

source /usr/lib/kurovpn/ui.sh 2>/dev/null || true
ui_require_root

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

clear
ui_header "Telegram Bot Setup" "Settings › Bot"

read -p "  Bot Token    : " TOKEN
[[ -z "$TOKEN" ]] && { echo "  Token required."; exit 0; }

read -p "  Admin Chat ID: " CHATID
[[ -z "$CHATID" ]] && { echo "  Chat ID required."; exit 0; }

# Save credentials
mkdir -p /etc/funny
echo "$TOKEN" > /etc/funny/.keybot
echo "$CHATID" > /etc/funny/.chatid
chmod 600 /etc/funny/.keybot /etc/funny/.chatid

echo ""
echo "  Credentials saved."
echo ""

# Validate token
BOT_USERNAME=$(curl -s --max-time 2 "https://api.telegram.org/bot${TOKEN}/getMe" 2>/dev/null | grep -o '"username":"[^"]*"' | cut -d'"' -f4)
if [[ -n "$BOT_USERNAME" ]]; then
    echo "  Token valid — bot @${BOT_USERNAME}"
else
    echo "  WARNING: Could not validate token. Check your token and try again."
fi

# Ensure bot.py is deployed
BOT_DEST="/opt/kurovpn/bot.py"
if [[ ! -f "$BOT_DEST" ]]; then
    mkdir -p "$(dirname "$BOT_DEST")"
    if [[ -f "$SCRIPT_DIR/../Plugin/bot.py" ]]; then
        cp "$SCRIPT_DIR/../Plugin/bot.py" "$BOT_DEST"
    elif [[ -f "/root/kurovpn/Plugin/bot.py" ]]; then
        cp "/root/kurovpn/Plugin/bot.py" "$BOT_DEST"
    else
        echo "  ERROR: bot.py not found. Re-run install.sh to deploy it."
        read -n1 -s -r -p "  Press any key..."
        exit 1
    fi
    chmod +x "$BOT_DEST"
    echo "  Deployed bot.py → $BOT_DEST"
fi

# Create systemd service
cat > /etc/systemd/system/kurovpn-bot.service << 'UNIT'
[Unit]
Description=KUROVPN Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kurovpn
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/kurovpn/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable kurovpn-bot 2>/dev/null || true
systemctl restart kurovpn-bot 2>/dev/null || true

sleep 2
echo ""
if systemctl is-active --quiet kurovpn-bot; then
    echo "  Bot is running. Send /start in Telegram."
else
    echo "  Bot failed to start. Last log entries:"
    journalctl -u kurovpn-bot -n 15 --no-pager 2>/dev/null
fi

echo ""
read -n1 -s -r -p "  Press any key..."
menu
