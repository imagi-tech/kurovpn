#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  xp — Auto-expiry sweeper (runs every 15 min via cron)

XRAY_CONFIG="/etc/xray/config.json"
USERS_FILE="/etc/kurovpn/users.json"
NOW=$(date +%Y-%m-%d)

[ -f "$USERS_FILE" ] || exit 0

echo -n > /var/log/xray/access.log 2>/dev/null

# ── Embedded xray helpers (no sourcing needed) ──────────
get_xray_ports() {
    case "$1" in
        vmess) echo "23456 31234 8001" ;;
        vless) echo "14016 24456 8003" ;;
        trojan) echo "25432 33456 8002" ;;
        ss) echo "10004" ;;
    esac
}

del_from_xray() {
    local proto="$1" field="$2" val="$3"
    local tmpfile="${XRAY_CONFIG}.tmp.$$"
    local ports=($(get_xray_ports "$proto"))
    for port in "${ports[@]}"; do
        cp "$XRAY_CONFIG" "$tmpfile" 2>/dev/null || continue
        jq --arg val "$val" \
            "(.inbounds[] | select(.port == $port) | .settings.clients) |= map(select(.\"$field\" != \$val))" \
            "$tmpfile" > "${tmpfile}.2" 2>/dev/null
        mv "${tmpfile}.2" "$tmpfile" 2>/dev/null
        cp "$tmpfile" "$XRAY_CONFIG" 2>/dev/null
    done
    rm -f "$tmpfile" "${tmpfile}.2"
}

del_from_users() {
    local proto="$1" user="$2"
    local tmpfile="${USERS_FILE}.tmp.$$"
    jq --arg proto "$proto" --arg user "$user" \
        '.[$proto] |= map(select(.user != $user))' \
        "$USERS_FILE" > "$tmpfile" 2>/dev/null
    mv "$tmpfile" "$USERS_FILE" 2>/dev/null
    chmod 600 "$USERS_FILE" 2>/dev/null
}

# ── Process Xray users ─────────────────────────────────
for proto in vmess vless trojan shadowsocks; do
    case "$proto" in
        vmess)       p="vmess"; field="id" ;;
        vless)       p="vless"; field="id" ;;
        trojan)      p="trojan"; field="password" ;;
        shadowsocks) p="ss"; field="password" ;;
    esac

    jq -r --arg now "$NOW" --arg proto "$proto" \
        '.[$proto][]? | select(.exp < $now) | "\(.user) \(.uuid // .password)"' \
        "$USERS_FILE" 2>/dev/null | while read user cred; do
        [[ -z "$user" ]] && continue
        del_from_xray "$p" "$field" "$cred"
        del_from_users "$proto" "$user"
        rm -rf /etc/funny/limit/xray/quota/"$user" /etc/funny/limit/xray/ip/"$user" 2>/dev/null
    done
done

# ── Process SSH users ──────────────────────────────────
cat /etc/shadow | cut -d: -f1,8 | sed '/:$/d' > /tmp/explist.$$
while IFS=: read username userexp; do
    [[ "$username" == "root" ]] && continue
    expire_sec=$((userexp * 86400))
    now_sec=$(date +%s)
    if [[ $expire_sec -lt $now_sec ]]; then
        userdel --force "$username" 2>/dev/null
        rm -f /etc/funny/limit/ssh/ip/"$username" 2>/dev/null
        del_from_users "ssh" "$username"
    fi
done < /tmp/explist.$$
rm -f /tmp/explist.$$

# ── Process L2TP users ─────────────────────────────────
if [[ -f /etc/funny/.l2tp ]]; then
    grep '^###' /etc/funny/.l2tp | while read _ user exp; do
        [[ "$exp" < "$NOW" ]] || continue
        sed -i "/^\"$user\" l2tpd/d" /etc/ppp/chap-secrets 2>/dev/null
        sed -i "/^$user:\$1\$/d" /etc/ipsec.d/passwd 2>/dev/null
        sed -i "/^### $user $exp/d" /etc/funny/.l2tp 2>/dev/null
        del_from_users "l2tp" "$user"
    done
fi

# ── Process WireGuard users ────────────────────────────
if [[ -f /etc/funny/.wg ]]; then
    grep '^###' /etc/funny/.wg | while read _ user exp; do
        [[ "$exp" < "$NOW" ]] || continue
        sed -i "/^### $user $exp/,/^$/d" /etc/wireguard/wg0.conf 2>/dev/null
        rm -f /etc/wireguard/clients/"$user".conf 2>/dev/null
        sed -i "/^### $user $exp/d" /etc/funny/.wg 2>/dev/null
        del_from_users "wireguard" "$user"
    done
    systemctl restart wg-quick@wg0 2>/dev/null
fi

# ── Restart ────────────────────────────────────────────
systemctl restart xray 2>/dev/null
chmod 600 /etc/ppp/chap-secrets /etc/ipsec.d/passwd "$USERS_FILE" 2>/dev/null
