#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Add VLess account (WS + gRPC + HTTPUpgrade)

source /usr/lib/kurovpn/common.sh 2>/dev/null || true
source /usr/lib/kurovpn/xray-clients.sh 2>/dev/null || true

XRAY_CONFIG="/etc/xray/config.json"
USERS_FILE="/etc/kurovpn/users.json"
domain=$(cat /etc/xray/domain 2>/dev/null || echo "unknown")

clear
echo -e "\n===================\n[ Create VLess Account ]\n===================\n"

while true; do
    read -p "Username  : " user
    [[ -z "$user" ]] && continue
    valid_username "$user" || { echo "Error: alphanumeric and underscore only."; continue; }
    user_exists "vless" "$user" && { echo "Error: user '$user' already exists."; continue; }
    break
done

while true; do
    read -p "Duration (days): " days
    [[ "$days" =~ ^[0-9]+$ ]] && [[ "$days" -gt 0 ]] && break
    echo "Error: enter a positive number."
done

exp=$(date -d "$days days" +%Y-%m-%d)
uuid=$(gen_uuid)
client_json=$(make_vless_client "$uuid" "$user")

xray_add_client "vless" "$client_json" || { echo "Error: failed to update Xray config."; exit 1; }
users_add "vless" "$user" "$exp" "\"uuid\":\"$uuid\""

link_ws="vless://${uuid}@${domain}:443?path=/vless&security=tls&encryption=none&type=ws&host=${domain}#${user}"
link_grpc="vless://${uuid}@${domain}:443?path=vless-grpc&security=tls&encryption=none&type=grpc&serviceName=vless-grpc&host=${domain}#${user}"
link_http="vless://${uuid}@${domain}:80?path=/rere&security=none&encryption=none&type=httpupgrade&host=${domain}#${user}"

clear
cat << EOF
=========================
[ Xray VLess Account ]
=========================
Remarks    : ${user}
Host/SNI   : ${domain}
UUID       : ${uuid}
Expired    : ${exp}
=========================
Port       : 443, 53, 2095
Network    : WS, gRPC, HTTPUpgrade
=========================
WS        : ${link_ws}
gRPC      : ${link_grpc}
HTTPUpgr  : ${link_http}
=========================
EOF

CHATID=$(cat /etc/funny/.chatid 2>/dev/null)
KEY=$(cat /etc/funny/.keybot 2>/dev/null)
if [[ -n "$KEY" && -n "$CHATID" ]]; then
    curl -s --max-time 10 -d "chat_id=$CHATID&text=VLess+$user+created+exp+$exp&parse_mode=html" \
        "https://api.telegram.org/bot$KEY/sendMessage" >/dev/null 2>&1
fi

if [[ -t 0 ]]; then
    read -n 1 -s -r -p "Press any key to continue..."
fi
echo ""

