#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  SSH Account Manager

source /usr/lib/kurovpn/ui.sh 2>/dev/null || true
ui_require_root

USERS_FILE="/etc/kurovpn/users.json"

# ── List SSH users ─────────────────────────────────────
list_ssh() {
    clear
    ui_header "SSH Users List" "SSH Manager › List"
    printf "  %-15s %-10s %s\n" "Username" "Expiry" "Status"
    echo  "  $(printf '%.s─' {1..40})"

    while IFS=: read user _ uid _ _ _ rest; do
        [[ "$uid" -lt 1000 ]] && continue
        [[ "$user" == "nobody" ]] && continue
        local exp
        exp=$(chage -l "$user" 2>/dev/null | grep "Account expires" | cut -d: -f2- | xargs)
        [[ -z "$exp" || "$exp" == "never" ]] && exp="never"
        local status
        passwd -S "$user" 2>/dev/null | grep -q "L" && status="${RED}Locked${NC}" || status="${GREEN}Active${NC}"
        printf "  %-15s %-10s %b\n" "$user" "$exp" "$status"
    done < /etc/passwd

    echo ""
    read -n 1 -s -r -p "  Press any key..."
}

# ── Delete SSH user ────────────────────────────────────
del_ssh() {
    clear
    ui_header "Delete SSH User" "SSH Manager › Delete"
    read -p "  Username to delete: " user
    [[ -z "$user" || "$user" == "root" ]] && return
    read -p "  Delete '$user'? [y/N]: " confirm
    [[ "$confirm" != "y" && "$confirm" != "Y" ]] && { echo "  Aborted."; sleep 1; return; }

    userdel --force "$user" 2>/dev/null
    rm -f /etc/funny/limit/ssh/ip/"$user" 2>/dev/null
    [[ -f "$USERS_FILE" ]] && {
        local t="${USERS_FILE}.tmp.$$"
        jq --arg u "$user" '.ssh |= map(select(.user != $u))' "$USERS_FILE" > "$t"
        mv "$t" "$USERS_FILE"
        chmod 600 "$USERS_FILE"
    }
    echo "  Deleted: $user"
    read -n 1 -s -r -p "  Press any key..."
}

# ── Renew SSH user ─────────────────────────────────────
renew_ssh() {
    clear
    ui_header "Renew SSH User" "SSH Manager › Renew"
    read -p "  Username: " user
    [[ -z "$user" ]] && return
    while true; do
        read -p "  Add days: " days
        [[ "$days" =~ ^[0-9]+$ ]] && [[ "$days" -gt 0 ]] && break
        echo "  Enter a positive number."
    done
    local old_exp new_exp
    old_exp=$(chage -l "$user" 2>/dev/null | grep "Account expires" | cut -d: -f2- | xargs)
    [[ "$old_exp" == "never" ]] && old_exp=$(date +%Y-%m-%d)
    new_exp=$(date -d "$old_exp + $days days" +%Y-%m-%d 2>/dev/null) || new_exp=$(date -d "+$days days" +%Y-%m-%d)
    chage -E "$new_exp" "$user" 2>/dev/null
    echo "  Renewed: $user → $new_exp"
    read -n 1 -s -r -p "  Press any key..."
}

# ── Trial account ──────────────────────────────────────
trial_ssh() {
    clear
    ui_header "Trial SSH Account"
    local tuser="trial$(tr -dc a-z0-9 </dev/urandom | head -c4)"
    local tpass=$(tr -dc A-Za-z0-9 </dev/urandom | head -c12)
    local texp=$(date -d "1 days" +%Y-%m-%d)

    useradd -e "$texp" -s /bin/false -M "$tuser" 2>/dev/null
    echo -e "$tpass\n$tpass" | passwd "$tuser" >/dev/null 2>&1

    ui_card_begin "Trial SSH (1 day)"
    ui_kv "Username" "$tuser"
    ui_kv "Password" "$tpass"
    ui_kv "Expired"  "$texp"
    ui_kv "Ports"    "22, 3303, 109, 111, 69"
    ui_card_end
    read -n 1 -s -r -p "  Press any key..."
}

# ── Online users ───────────────────────────────────────
online_ssh() {
    clear
    ui_header "Online SSH / Dropbear"
    netstat -tnp 2>/dev/null | grep -E ":(22|3303|109|111|69)" | grep ESTABLISHED | awk '{print $5}' | cut -d: -f1 | sort -u | while read ip; do
        echo "  $ip"
    done
    echo ""
    read -n 1 -s -r -p "  Press any key..."
}

# ── Main menu ──────────────────────────────────────────
while true; do
    clear
    ui_header "SSH Account Manager" "Main › SSH"
    ui_item 1 "Create Account"
    ui_item 2 "Trial Account (1 day)"
    ui_item 3 "List Users"
    ui_item 4 "Delete User"
    ui_item 5 "Renew User"
    ui_item 6 "Online Users"
    echo ""
    ui_footer
    read -p "  Select: " opt
    case "$opt" in
        1) addssh ;;
        2) trial_ssh ;;
        3) list_ssh ;;
        4) del_ssh ;;
        5) renew_ssh ;;
        6) online_ssh ;;
        X|x) clear; exit 0 ;;
    esac
done
