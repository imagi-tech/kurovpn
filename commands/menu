#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Main dashboard menu

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; NC='\033[0m'

domain=$(cat /etc/xray/domain 2>/dev/null || echo "unknown")
MYIP=$(curl -s ipinfo.io/ip 2>/dev/null || echo "unknown")

while true; do
clear
echo -e "${CYAN}==================================================================${NC}"
echo -e "${YELLOW}                      KUROVPN MAIN MENU                          ${NC}"
echo -e "${CYAN}==================================================================${NC}"
echo -e "  Domain : ${GREEN}${domain}${NC}"
echo -e "  IP     : ${GREEN}${MYIP}${NC}"
echo -e "${CYAN}------------------------------------------------------------------${NC}"
echo ""

# Service status
for svc in xray nginx dropbear edu "wg-quick@wg0" xl2tpd ipsec pptpd badvpn; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        icon="${GREEN}[RUNNING]${NC}"
    else
        icon="${RED}[STOPPED]${NC}"
    fi
    printf "  %-25s %s\n" "$svc" "$icon"
done

echo ""
echo -e "${CYAN}------------------------------------------------------------------${NC}"
echo -e " ${GREEN}1${NC}) SSH Menu        ${GREEN}5${NC}) WireGuard Menu"
echo -e " ${GREEN}2${NC}) Xray Menu       ${GREEN}6${NC}) System Menu"
echo -e " ${GREEN}3${NC}) L2TP Menu       ${GREEN}7${NC}) Bot / Backup"
echo -e " ${GREEN}4${NC}) NoobZVPNS       ${GREEN}8${NC}) Domain & Cert"
echo ""
echo -e " ${RED}X${NC}) Exit"
echo -e "${CYAN}==================================================================${NC}"
read -p "  Select [1-8]: " opt

case "$opt" in
    1) menu-ssh ;;
    2) menu-xray ;;
    3) lmenu ;;
    4) nmenu ;;
    5) Menu-WGF ;;
    6) menu-set ;;
    7) bmenu ;;
    8) dm-menu ;;
    X|x) clear; exit 0 ;;
esac
done
