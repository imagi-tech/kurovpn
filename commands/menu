#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Main dashboard menu

source /usr/lib/kurovpn/ui.sh

domain=$(cat /etc/xray/domain 2>/dev/null || echo "unknown")
MYIP=$(curl -s ipinfo.io/ip 2>/dev/null || echo "unknown")

while true; do
clear
ui_header "Main Menu" "Dashboard"

# ── Server info ──────────────────────────────
ui_kv "Domain" "$domain"
ui_kv "IP"     "$MYIP"
echo ""

# ── Service status ───────────────────────────
ui_section "Services"
for svc in xray nginx dropbear edu "wg-quick@wg0" xl2tpd ipsec pptpd badvpn hysteria; do
    ui_running "$svc"
done

echo ""
# ── Menu options ─────────────────────────────
ui_card_begin "Quick Access"
_col1="1) SSH Menu         5) WireGuard"
_col2="2) Xray Manager     6) System Menu"
_col3="3) L2TP/IPsec       7) Bot & Backup"
_col4="4) NoobZVPNS        8) Domain & Cert"
_card_row "${GREEN}1)${NC} SSH Menu       ${GREEN}5)${NC} WireGuard"
_card_row "${GREEN}2)${NC} Xray Manager   ${GREEN}6)${NC} System Menu"
_card_row "${GREEN}3)${NC} L2TP/IPsec       ${GREEN}7)${NC} Bot & Backup"
_card_row "${GREEN}4)${NC} NoobZVPNS          ${GREEN}8)${NC} Domain & Cert"
ui_card_end

ui_footer
read -p "  Select [1-8]: " opt

case "$opt" in
    1) menu-ssh ;;
    2) menu-xray ;;
    3) lmenu ;;
    4) nmenu ;;
    5) Menu-WGF ;;
    6) menu-set ;;
    7) bmenu ;;
    8) dm-menu ;;
    X|x) clear; exit 0 ;;
esac
done
