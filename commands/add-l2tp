#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Add L2TP/IPsec account

PSK="kurovpn-psk"
USERS_FILE="/etc/kurovpn/users.json"
PUBLIC_IP=$(curl -s ipinfo.io/ip 2>/dev/null || echo "")

clear
echo -e "\n===================\n[ Create L2TP Account ]\n===================\n"

while true; do
    read -p "Username  : " VPN_USER
    [[ -z "$VPN_USER" ]] && continue
    grep -qw "^$VPN_USER" /etc/ppp/chap-secrets 2>/dev/null && { echo "Error: user already exists."; continue; }
    break
done

while true; do
    read -s -p "Password  : " VPN_PASS; echo
    [[ -z "$VPN_PASS" ]] && { echo "Error: password cannot be empty."; continue; }
    break
done

while true; do
    read -p "Duration (days): " days
    [[ "$days" =~ ^[0-9]+$ ]] && [[ "$days" -gt 0 ]] && break
    echo "Error: enter a positive number."
done

exp=$(date -d "$days days" +%Y-%m-%d)
pass_enc=$(openssl passwd -1 "$VPN_PASS")

grep -q "^$VPN_USER " /etc/ppp/chap-secrets 2>/dev/null || \
    echo "$VPN_USER l2tpd $VPN_PASS *" >> /etc/ppp/chap-secrets
grep -q "^$VPN_USER:" /etc/ipsec.d/passwd 2>/dev/null || \
    echo "$VPN_USER:$pass_enc:xauth-psk" >> /etc/ipsec.d/passwd

echo "### $VPN_USER $exp" >> /etc/funny/.l2tp
chmod 600 /etc/ppp/chap-secrets /etc/ipsec.d/passwd 2>/dev/null

# Users DB
if [[ -f "$USERS_FILE" ]]; then
    tmpfile="${USERS_FILE}.tmp.$$"
    jq --arg u "$VPN_USER" --arg e "$exp" --arg c "$(date +%Y-%m-%d)" \
       '.l2tp += [{"user":$u,"exp":$e,"created":$c}]' "$USERS_FILE" > "$tmpfile"
    mv "$tmpfile" "$USERS_FILE" 2>/dev/null
    chmod 600 "$USERS_FILE" 2>/dev/null
fi

clear
cat << EOF
=========================
[ L2TP/IPsec Account ]
=========================
Username   : ${VPN_USER}
Password   : ${VPN_PASS}
PSK        : ${PSK}
Expired    : ${exp}
=========================
Server IP  : ${PUBLIC_IP}
=========================
EOF
echo ""
read -n 1 -s -r -p "Press any key to go back..."
lmenu
