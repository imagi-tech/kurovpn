#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Xray Core Manager (VMess, VLess, Reality, Trojan, Shadowsocks-2022)

source /usr/lib/kurovpn/ui.sh 2>/dev/null || source /home/azureuser/vpn_script/lib/ui.sh 2>/dev/null || true
ui_require_root
source /usr/lib/kurovpn/xray-clients.sh 2>/dev/null || source /home/azureuser/vpn_script/lib/xray-clients.sh 2>/dev/null || true

XRAY_CONFIG="/etc/xray/config.json"
USERS_FILE="/etc/kurovpn/users.json"

# ── List xray users ────────────────────────────────────
list_users() {
    clear
    ui_header "Xray Users List" "Xray › List"

    printf "  %-10s %-16s %-12s %s\n" "Protocol" "Username" "Expiry" "UUID / Password"
    echo  "  $(printf '%.s─' {1..52})"

    local found=0
    if [[ -f "$USERS_FILE" ]]; then
        for p in vmess vless reality trojan ss2022; do
            while read u e uid; do
                [[ -z "$u" ]] && continue
                printf "  %-10s %-16s %-12s %s\n" "$p" "$u" "$e" "$uid"
                found=1
            done < <(jq -r ".\"$p\"[]? | \"\(.user) \(.exp) \(.uuid // .password)\"" "$USERS_FILE" 2>/dev/null)
        done
    fi
    [[ "$found" -eq 0 ]] && echo "  No Xray users found."
    ui_wait_key
}

# ── Delete a user ──────────────────────────────────────
del_user() {
    clear
    ui_header "Delete Xray User" "Xray › Delete"
    echo ""
    ui_item 1 "VMess"
    ui_item 2 "VLess"
    ui_item 3 "VLess Reality"
    ui_item 4 "Trojan"
    ui_item 5 "Shadowsocks-2022"
    echo ""
    read -p "  Select Protocol [1-5]: " proto_choice
    case "$proto_choice" in
        1) local proto="vmess" field="id" db="vmess" ;;
        2) local proto="vless" field="id" db="vless" ;;
        3) local proto="reality" field="id" db="reality" ;;
        4) local proto="trojan" field="password" db="trojan" ;;
        5) local proto="ss2022" field="password" db="ss2022" ;;
        *) echo "  Invalid."; ui_wait_key; return ;;
    esac

    read -p "  Username to delete: " user
    [[ -z "$user" ]] && return

    local val
    val=$(jq -r --arg u "$user" ".\"$db\"[] | select(.user==\$u) | .uuid // .password" "$USERS_FILE" 2>/dev/null)
    [[ -z "$val" ]] && { echo "  User '$user' not found."; ui_wait_key; return; }

    read -p "  Delete '$user'? [y/N]: " confirm
    [[ "$confirm" != "y" && "$confirm" != "Y" ]] && return

    case "$proto" in
        ss2022) xray_del_ss2022_client "$val" ;;
        *)      xray_del_client "$proto" "$field" "$val" ;;
    esac
    users_del "$db" "$user"
    echo "  Deleted: $user"
    ui_wait_key
}

# ── Renew an account ───────────────────────────────────
renew_user() {
    clear
    ui_header "Renew Xray User" "Xray › Renew"
    read -p "  Username: " user
    [[ -z "$user" ]] && return

    local found_proto=""
    local old_exp=""
    for p in vmess vless reality trojan ss2022; do
        old_exp=$(jq -r --arg u "$user" ".\"$p\"[]? | select(.user==\$u) | .exp" "$USERS_FILE" 2>/dev/null)
        if [[ -n "$old_exp" && "$old_exp" != "null" ]]; then
            found_proto="$p"
            break
        fi
    done

    if [[ -z "$found_proto" ]]; then
        echo "  User '$user' not found."
        ui_wait_key
        return
    fi

    read -p "  Add Days: " days
    [[ ! "$days" =~ ^[0-9]+$ ]] && { echo "  Invalid duration."; ui_wait_key; return; }

    local new_exp
    new_exp=$(date -d "$old_exp + $days days" +%Y-%m-%d)

    local t="${USERS_FILE}.tmp.$$"
    jq --arg p "$found_proto" --arg u "$user" --arg e "$new_exp" \
        '.[$p] = [.[$p][] | if .user == $u then .exp = $e else . end]' \
        "$USERS_FILE" > "$t" && mv "$t" "$USERS_FILE"
    chmod 600 "$USERS_FILE"

    echo "  Renewed '$user' ($found_proto): $old_exp → $new_exp"
    ui_wait_key
}

# ── Online users check ─────────────────────────────────
online_check() {
    clear
    ui_header "Active Connections" "Xray › Online"
    echo "  Scanning current established connections to Xray ports..."
    echo ""
    local conns
    conns=$(ss -tnp 2>/dev/null | grep -E ':23456|:14016|:8443|:25432|:10010' | awk '{print $5}' | cut -d: -f1 | sort -u)
    if [[ -n "$conns" ]]; then
        echo "  Connected Remote IPs:"
        echo "$conns" | sed 's/^/    ● /'
    else
        echo "  No active client connections right now."
    fi
    echo ""
    ui_wait_key
}

# ── Service status ─────────────────────────────────────
check_status() {
    clear
    ui_header "Xray Service Status" "Xray › Status"

    if systemctl is-active --quiet xray; then
        ui_kv "Xray Status" "${GREEN}Running (Active)${NC}"
        echo ""
        local vmess_count=$(jq '.vmess | length' "$USERS_FILE" 2>/dev/null || echo 0)
        local vless_count=$(jq '.vless | length' "$USERS_FILE" 2>/dev/null || echo 0)
        local reality_count=$(jq '.reality | length' "$USERS_FILE" 2>/dev/null || echo 0)
        local trojan_count=$(jq '.trojan | length' "$USERS_FILE" 2>/dev/null || echo 0)
        local ss2022_count=$(jq '.ss2022 | length' "$USERS_FILE" 2>/dev/null || echo 0)

        ui_kv "VMess Accounts" "$vmess_count"
        ui_kv "VLess Accounts" "$vless_count"
        ui_kv "Reality Accounts" "$reality_count"
        ui_kv "Trojan Accounts" "$trojan_count"
        ui_kv "SS-2022 Accounts" "$ss2022_count"
    else
        ui_kv "Xray Status" "${RED}Stopped (Inactive)${NC}"
    fi

    echo ""
    ui_wait_key
}

# ── Main menu ──────────────────────────────────────────
while true; do
    clear
    ui_header "Xray Core Manager" "Main › Xray"

    ui_card_begin "Create Accounts"
    _card_row "${GREEN} 1)${NC} VMess (WS / gRPC)"
    _card_row "${GREEN} 2)${NC} VLess (WS / gRPC / NTLS)"
    _card_row "${GREEN} 3)${NC} VLess Reality (Vision)"
    _card_row "${GREEN} 4)${NC} Trojan (WS / gRPC)"
    _card_row "${GREEN} 5)${NC} Shadowsocks-2022"
    ui_card_end

    ui_card_begin "Management"
    _card_row "${GREEN} 6)${NC} List All Xray Users"
    _card_row "${GREEN} 7)${NC} Renew User Account"
    _card_row "${GREEN} 8)${NC} Delete User Account"
    _card_row "${GREEN} 9)${NC} Check Online Users"
    _card_row "${GREEN}10)${NC} Service Status"
    ui_card_end

    ui_footer
    read -p "  Select Option [1-10]: " opt
    case "$opt" in
        1) add-vmess ;;
        2) add-vless ;;
        3) add-reality ;;
        4) add-trojan ;;
        5) add-ss2022 ;;
        6) list_users ;;
        7) renew_user ;;
        8) del_user ;;
        9) online_check ;;
        10) check_status ;;
        X|x) exit 0 ;;
        *) ;;
    esac
done
