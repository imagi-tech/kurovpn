#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Backup & Restore menu

source /usr/lib/kurovpn/ui.sh 2>/dev/null || true
ui_require_root

while true; do
clear
ui_header "Backup & Restore" "Main › Settings › Backup"

ui_item 1 "Create Backup"
ui_item 2 "Restore from Local File"
ui_item 3 "Telegram Bot Setup"

echo ""
ui_footer
read -p "  Select: " opt
case "$opt" in
    1) backup ;;
    2)
        read -p "  Path to backup file: " bfile
        [[ ! -f "$bfile" ]] && { echo "  File not found."; sleep 2; continue; }
        read -p "  Restore from $bfile? This overwrites current configs. [y/N]: " c
        [[ "$c" != "y" ]] && continue

        tmp="/tmp/kurovpn-restore-$$"
        rm -rf "$tmp"; mkdir -p "$tmp"
        tar xzf "$bfile" -C "$tmp" 2>/dev/null || { echo "  Invalid backup."; rm -rf "$tmp"; sleep 2; continue; }

        [[ -d "$tmp/xray" ]] && cp -r "$tmp/xray" /etc/
        [[ -d "$tmp/kurovpn" ]] && cp -r "$tmp/kurovpn" /etc/
        [[ -d "$tmp/funny" ]] && cp -r "$tmp/funny" /etc/
        [[ -d "$tmp/wireguard" ]] && cp -r "$tmp/wireguard" /etc/
        [[ -f "$tmp/chap-secrets" ]] && cp "$tmp/chap-secrets" /etc/ppp/
        [[ -f "$tmp/passwd-ipsec" ]] && cp "$tmp/passwd-ipsec" /etc/ipsec.d/passwd
        [[ -f "$tmp/ipsec.conf" ]] && cp "$tmp/ipsec.conf" /etc/
        [[ -f "$tmp/nginx.conf" ]] && cp "$tmp/nginx.conf" /etc/nginx/

        rm -rf "$tmp"
        systemctl restart xray nginx wg-quick@wg0 ipsec xl2tpd 2>/dev/null
        echo "  Restore complete."
        read -n1 -s -r -p "  Press any key..."
        ;;
    3) botmenu ;;
    X|x) exit 0 ;;
esac
done
