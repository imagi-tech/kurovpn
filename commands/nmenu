#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  NoobZVPNS Account Manager

source /usr/lib/kurovpn/ui.sh 2>/dev/null || true
ui_require_root
USERS_FILE="/etc/kurovpn/users.json"

list_noobz() {
    clear
    ui_header "NoobZVPNS Users"
    if [[ -x /usr/bin/noobzvpns ]]; then
        /usr/bin/noobzvpns --info-all-user 2>/dev/null || echo "  No users yet."
    else
        echo "  NoobZVPNS is not installed."
    fi
    ui_wait_key
}

add_noobz() {
    clear
    ui_header "Create NoobZVPNS Account"
    if [[ ! -x /usr/bin/noobzvpns ]]; then
        echo "  NoobZVPNS is not installed."
        ui_wait_key
        return
    fi
    read -p "  Username  : " user
    read -s -p "  Password  : " pass; echo
    read -p "  Days      : " days
    [[ -z "$user" || -z "$pass" || ! "$days" =~ ^[0-9]+$ ]] && { echo "  Invalid input."; ui_wait_key; return; }
    /usr/bin/noobzvpns --add-user "$user" "$pass" "$days" 2>/dev/null && echo "  Added: $user" || echo "  Failed."
    ui_wait_key
}

del_noobz() {
    clear
    ui_header "Delete NoobZVPNS User"
    if [[ ! -x /usr/bin/noobzvpns ]]; then echo "  Not installed."; ui_wait_key; return; fi
    read -p "  Username to delete: " user
    /usr/bin/noobzvpns --remove-user "$user" 2>/dev/null && echo "  Deleted: $user" || echo "  Failed."
    ui_wait_key
}

while true; do
clear
ui_header "NoobZVPNS Manager" "Main › NoobZVPNS"

if [[ -x /usr/bin/noobzvpns ]]; then
    ui_item 1 "Create Account"
    ui_item 2 "List Users"
    ui_item 3 "Delete User"
else
    echo "  [NoobZVPNS not installed]"
fi

echo ""
ui_footer
read -p "  Select: " opt
case "$opt" in
    1) add_noobz ;;
    2) list_noobz ;;
    3) del_noobz ;;
    X|x) exit 0 ;;
esac
done
