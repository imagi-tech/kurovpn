#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  backup — Backup KUROVPN configuration

BACKUP_FILE="/root/backup-$(date +%Y%m%d-%H%M).tar.gz"
TMP_DIR="/root/kurovpn-backup-tmp"

rm -rf "$TMP_DIR" 2>/dev/null
mkdir -p "$TMP_DIR"

# Copy config files
cp -r /etc/xray "$TMP_DIR/" 2>/dev/null
cp -r /etc/kurovpn "$TMP_DIR/" 2>/dev/null
cp -r /etc/funny "$TMP_DIR/" 2>/dev/null
cp -r /etc/noobzvpns "$TMP_DIR/" 2>/dev/null
cp -r /etc/wireguard "$TMP_DIR/" 2>/dev/null
cp /etc/ppp/chap-secrets "$TMP_DIR/" 2>/dev/null
cp /etc/ipsec.d/passwd "$TMP_DIR/passwd-ipsec" 2>/dev/null
cp /etc/ipsec.conf "$TMP_DIR/" 2>/dev/null
cp /etc/ipsec.secrets "$TMP_DIR/" 2>/dev/null
cp /etc/nginx/nginx.conf "$TMP_DIR/" 2>/dev/null

# Create archive
tar czf "$BACKUP_FILE" -C "$TMP_DIR" . 2>/dev/null
rm -rf "$TMP_DIR"

if [[ -f "$BACKUP_FILE" ]]; then
    echo "Backup saved: $BACKUP_FILE ($(du -h "$BACKUP_FILE" | cut -f1))"

    # Telegram notification
    CHATID=$(cat /etc/funny/.chatid 2>/dev/null)
    KEY=$(cat /etc/funny/.keybot 2>/dev/null)
    if [[ -n "$KEY" && -n "$CHATID" ]]; then
        curl -s --max-time 10 -F "chat_id=$CHATID" -F "document=@$BACKUP_FILE" \
            "https://api.telegram.org/bot$KEY/sendDocument" >/dev/null 2>&1
    fi
else
    echo "Backup failed."
fi
