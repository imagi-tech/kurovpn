#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Add VMess account (WS + gRPC + HTTPUpgrade)

source /usr/lib/kurovpn/common.sh 2>/dev/null || true
source /usr/lib/kurovpn/xray-clients.sh 2>/dev/null || true
source /usr/lib/kurovpn/ui.sh 2>/dev/null || true
ui_require_root

XRAY_CONFIG="/etc/xray/config.json"
USERS_FILE="/etc/kurovpn/users.json"
domain=$(cat /etc/xray/domain 2>/dev/null || echo "unknown")

clear
ui_header "Create VMess Account" "Xray › New VMess"

# Username
while true; do
    read -p "Username  : " user || exit 1
    [[ -z "$user" ]] && continue
    valid_username "$user" || { echo "Error: alphanumeric and underscore only."; continue; }
    user_exists "vmess" "$user" && { echo "Error: user '$user' already exists."; continue; }
    break
done

# Expiry
while true; do
    read -p "Duration (days): " days || exit 1
    [[ "$days" =~ ^[0-9]+$ ]] && [[ "$days" -gt 0 ]] && break
    echo "Error: enter a positive number."
done

exp=$(date -d "$days days" +%Y-%m-%d)
uuid=$(gen_uuid)
client_json=$(make_vmess_client "$uuid" "$user")

source /usr/lib/kurovpn/subscription.sh 2>/dev/null || true

# Add to Xray config
xray_add_client "vmess" "$client_json" || { echo "Error: failed to update Xray config."; exit 1; }

# Add to users DB
users_add "vmess" "$user" "$exp" "\"uuid\":\"$uuid\""

# Build subscription immediately
sub_build_user "$user" 2>/dev/null || true

# Build client links with distinct profile remarks
cat > /tmp/vmess_tls.json << LEOF
{"v":"2","ps":"${user}-WS-TLS","add":"${domain}","port":"443","id":"${uuid}","aid":"0","net":"ws","path":"/vmess","type":"none","host":"${domain}","tls":"tls"}
LEOF
cat > /tmp/vmess_none.json << LEOF
{"v":"2","ps":"${user}-WS-HTTP","add":"${domain}","port":"80","id":"${uuid}","aid":"0","net":"ws","path":"/vmess","type":"none","host":"${domain}","tls":"none"}
LEOF
cat > /tmp/vmess_grpc.json << LEOF
{"v":"2","ps":"${user}-gRPC-TLS","add":"${domain}","port":"443","id":"${uuid}","aid":"0","net":"grpc","path":"vmess-grpc","type":"none","host":"${domain}","tls":"tls"}
LEOF

link1="vmess://$(base64 -w 0 < /tmp/vmess_tls.json)"
link2="vmess://$(base64 -w 0 < /tmp/vmess_none.json)"
link3="vmess://$(base64 -w 0 < /tmp/vmess_grpc.json)"
rm -f /tmp/vmess_*.json

clear
ui_card_begin "Xray VMess Account"
ui_kv "Remarks"      "${user}"
ui_kv "Host/SNI"     "${domain}"
ui_kv "UUID"         "${uuid}"
ui_kv "Expired"      "${exp}"
ui_kv "Port TLS"     "443, 53, 2095"
ui_kv "Port HTTP"    "80, 2082"
ui_kv "Network"      "WS, gRPC, HTTPUpgrade"
ui_kv "Path WS"      "/vmess"
ui_kv "ServiceName"  "vmess-grpc"
ui_kv "Subscription" "https://${domain}/sub/${user}"
ui_card_end

echo -e "\n  ${YELLOW}─── Client Import Links (Copy all at once to Happ/v2rayN) ───${NC}"
echo "$link1"
echo "$link2"
echo "$link3"
echo -e "  ${YELLOW}─────────────────────────────────────────────────────────────${NC}\n"

echo -e "  ${GREEN}Subscription Link:${NC} https://${domain}/sub/${user}"
echo -e "  ${GREEN}Plaintext Link   :${NC} https://${domain}/sub/${user}.txt"

ui_qr "$link1" "Scan VMess (TLS) QR Code"

# Telegram notification
CHATID=$(cat /etc/funny/.chatid 2>/dev/null)
KEY=$(cat /etc/funny/.keybot 2>/dev/null)
if [[ -n "$KEY" && -n "$CHATID" ]]; then
    curl -s --max-time 2 -d "chat_id=$CHATID&text=VMess+$user+created+exp+$exp&parse_mode=html" \
        "https://api.telegram.org/bot$KEY/sendMessage" >/dev/null 2>&1
fi

ui_wait_key

