#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Add SSH account (OpenSSH + Dropbear)

USERS_FILE="/etc/kurovpn/users.json"
domain=$(cat /etc/xray/domain 2>/dev/null || echo "")
PUBLIC_IP=$(curl -s --connect-timeout 2 ipinfo.io/ip 2>/dev/null || echo "")

source /usr/lib/kurovpn/ui.sh 2>/dev/null || true
ui_require_root

clear
ui_header "Create SSH Account" "SSH › New"

while true; do
    read -p "Username  : " Login
    [[ -z "$Login" ]] && continue
    [[ "$Login" =~ ^[a-zA-Z0-9_]+$ ]] || { echo "Error: alphanumeric and underscore only."; continue; }
    id "$Login" &>/dev/null && { echo "Error: user '$Login' already exists."; continue; }
    break
done

while true; do
    read -s -p "Password  : " Pass; echo
    [[ -z "$Pass" ]] && { echo "Error: password cannot be empty."; continue; }
    [[ ${#Pass} -ge 6 ]] || { echo "Error: password must be at least 6 characters."; continue; }
    break
done

while true; do
    read -p "Duration (days): " days || exit 1
    [[ "$days" =~ ^[0-9]+$ ]] && [[ "$days" -gt 0 ]] && break
    echo "Error: enter a positive number."
done

while true; do
    read -p "IP Limit   : " iplimit
    [[ "$iplimit" =~ ^[0-9]+$ ]] && [[ "$iplimit" -ge 1 ]] && break
    echo "Error: enter a positive number."
done

exp=$(date -d "$days days" +%Y-%m-%d)
useradd -e "$exp" -s /bin/false -M "$Login" 2>/dev/null
echo -e "$Pass\n$Pass" | passwd "$Login" >/dev/null 2>&1

# IP limit
mkdir -p /etc/funny/limit/ssh/ip
echo "$iplimit" > "/etc/funny/limit/ssh/ip/$Login"

# Users DB
if [[ -f "$USERS_FILE" ]]; then
    tmpfile="${USERS_FILE}.tmp.$$"
    jq --arg u "$Login" --arg e "$exp" --arg c "$(date +%Y-%m-%d)" --argjson l "$iplimit" \
       '.ssh += [{"user":$u,"exp":$e,"created":$c,"iplimit":$l}]' "$USERS_FILE" > "$tmpfile"
    mv "$tmpfile" "$USERS_FILE" 2>/dev/null
    chmod 600 "$USERS_FILE" 2>/dev/null
    source /usr/lib/kurovpn/subscription.sh 2>/dev/null || true
    sub_build_user "$Login" 2>/dev/null || true
fi

clear
ui_card_begin "SSH Account"
ui_kv "Username"  "${Login}"
ui_kv "Password"  "${Pass}"
ui_kv "IP Limit"  "${iplimit}"
ui_kv "Expired"   "${exp}"
ui_kv "Host"      "${domain:-$PUBLIC_IP}"
ui_kv "OpenSSH"   "22, 3303"
ui_kv "Dropbear"  "109, 111, 69"
ui_kv "WS TLS"    "443"
ui_kv "WS HTTP"   "80, 2082"
ui_card_end
echo -e "  ${CYAN}Payload WS:${NC}"
echo -e "  GET / HTTP/1.1[crlf]Host: ${domain}[crlf]Upgrade: websocket[crlf][crlf]"
ui_wait_key
