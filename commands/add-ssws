#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Add Shadowsocks WebSocket account

source /usr/lib/kurovpn/common.sh 2>/dev/null || true
source /usr/lib/kurovpn/xray-clients.sh 2>/dev/null || true

XRAY_CONFIG="/etc/xray/config.json"
USERS_FILE="/etc/kurovpn/users.json"
domain=$(cat /etc/xray/domain 2>/dev/null || echo "unknown")

clear
echo -e "\n===================\n[ Create Shadowsocks Account ]\n===================\n"

while true; do
    read -p "Username  : " user
    [[ -z "$user" ]] && continue
    valid_username "$user" || { echo "Error: alphanumeric and underscore only."; continue; }
    user_exists "shadowsocks" "$user" && { echo "Error: user '$user' already exists."; continue; }
    break
done

while true; do
    read -p "Duration (days): " days
    [[ "$days" =~ ^[0-9]+$ ]] && [[ "$days" -gt 0 ]] && break
    echo "Error: enter a positive number."
done

exp=$(date -d "$days days" +%Y-%m-%d)
password=$(gen_uuid)
client_json=$(make_ss_client "$password" "$user")

xray_add_client "ss" "$client_json" || { echo "Error: failed to update Xray config."; exit 1; }
users_add "shadowsocks" "$user" "$exp" "\"password\":\"$password\""

# ss:// base64 link
ss_raw="${password}:aes-128-gcm@${domain}:443"
ss_link="ss://$(echo -n "aes-128-gcm:${password}" | base64 -w 0)@${domain}:443?path=/ssws&security=tls&type=ws&host=${domain}#${user}"

clear
cat << EOF
=========================
[ Shadowsocks Account ]
=========================
Remarks    : ${user}
Host       : ${domain}
Password   : ${password}
Method     : aes-128-gcm
Expired    : ${exp}
Port TLS   : 443
Network    : WebSocket
Path       : /ssws
=========================
${ss_link}
=========================
EOF

CHATID=$(cat /etc/funny/.chatid 2>/dev/null)
KEY=$(cat /etc/funny/.keybot 2>/dev/null)
if [[ -n "$KEY" && -n "$CHATID" ]]; then
    curl -s --max-time 10 -d "chat_id=$CHATID&text=SS+$user+created+exp+$exp&parse_mode=html" \
        "https://api.telegram.org/bot$KEY/sendMessage" >/dev/null 2>&1
fi

echo ""
read -n 1 -s -r -p "Press any key to go back..."
menu-xray
