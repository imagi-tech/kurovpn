#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Add Hysteria2 account (QUIC/UDP)

source /usr/lib/kurovpn/common.sh 2>/dev/null || true
source /usr/lib/kurovpn/xray-clients.sh 2>/dev/null || true
source /usr/lib/kurovpn/hysteria-clients.sh 2>/dev/null || true
source /usr/lib/kurovpn/ui.sh 2>/dev/null || true
ui_require_root

USERS_FILE="/etc/kurovpn/users.json"
domain=$(cat /etc/xray/domain 2>/dev/null || echo "unknown")

clear
ui_header "Create Hysteria2 Account" "Xray › New Hysteria2"

while true; do
    read -p "Username  : " user || exit 1
    [[ -z "$user" ]] && continue
    valid_username "$user" || { echo "Error: alphanumeric and underscore only."; continue; }
    user_exists "hysteria2" "$user" && { echo "Error: user '$user' already exists."; continue; }
    break
done

while true; do
    read -p "Duration (days): " days || exit 1
    [[ "$days" =~ ^[0-9]+$ ]] && [[ "$days" -gt 0 ]] && break
    echo "Error: enter a positive number."
done

exp=$(date -d "$days days" +%Y-%m-%d)
password=$(openssl rand -base64 24 2>/dev/null | tr '+/' '-_' | tr -d '=\n')

source /usr/lib/kurovpn/subscription.sh 2>/dev/null || true

hy_add_user "$user" "$password" "$exp" || { echo -e "\n  ${RED}[ERROR] Failed to add Hysteria2 user.${NC}"; ui_wait_key; exit 1; }

# Build subscription immediately
sub_build_user "$user" 2>/dev/null || true

link="hy2://${user}:${password}@${domain}:443?insecure=1&sni=${domain}#${user}-Hy2"
link_dns="hy2://${user}:${password}@${domain}:53?insecure=1&sni=${domain}#${user}-Hy2-53"

clear
ui_card_begin "Hysteria2 Account"
ui_kv "Username"         "${user}"
ui_kv "Password"         "${password}"
ui_kv "Host/SNI"         "${domain}"
ui_kv "Port Standard"    "443 (UDP/QUIC)"
ui_kv "Port DNS Bypass"  "53 (UDP/QUIC)"
ui_kv "Expired"          "${exp}"
ui_kv "Subscription"     "https://${domain}/sub/${user}"
ui_card_end

echo -e "\n  ${YELLOW}─── Client Import Links (Copy-Paste to Happ/v2rayN/NekoBox) ───${NC}"
echo "$link"
echo "$link_dns"
echo -e "  ${YELLOW}─────────────────────────────────────────────────────────────${NC}\n"

echo -e "  ${GREEN}Subscription Link:${NC} https://${domain}/sub/${user}"
echo -e "  ${GREEN}Plaintext Link   :${NC} https://${domain}/sub/${user}.txt"

ui_qr "$link" "Scan Hysteria2 (Port 443) QR Code"

# Telegram notification
CHATID=""
KEY=""
[[ -f /etc/funny/.chatid ]] && CHATID=$(cat /etc/funny/.chatid)
[[ -f /etc/funny/.keybot ]] && KEY=$(cat /etc/funny/.keybot)
if [[ -n "$KEY" && -n "$CHATID" ]]; then
    curl -s --max-time 2 -d "chat_id=$CHATID&text=Hysteria2+$user+created+exp+$exp&parse_mode=html" \
        "https://api.telegram.org/bot$KEY/sendMessage" >/dev/null 2>&1
fi

ui_wait_key

