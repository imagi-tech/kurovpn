#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  Add Trojan account (WS + gRPC + HTTPUpgrade)

source /usr/lib/kurovpn/common.sh 2>/dev/null || true
source /usr/lib/kurovpn/xray-clients.sh 2>/dev/null || true
source /usr/lib/kurovpn/ui.sh 2>/dev/null || true
ui_require_root

XRAY_CONFIG="/etc/xray/config.json"
USERS_FILE="/etc/kurovpn/users.json"
domain=$(cat /etc/xray/domain 2>/dev/null || echo "unknown")

clear
ui_header "Create Trojan Account" "Xray › New Trojan"

while true; do
    read -p "Username  : " user || exit 1
    [[ -z "$user" ]] && continue
    valid_username "$user" || { echo "Error: alphanumeric and underscore only."; continue; }
    user_exists "trojan" "$user" && { echo "Error: user '$user' already exists."; continue; }
    break
done

while true; do
    read -p "Duration (days): " days || exit 1
    [[ "$days" =~ ^[0-9]+$ ]] && [[ "$days" -gt 0 ]] && break
    echo "Error: enter a positive number."
done

exp=$(date -d "$days days" +%Y-%m-%d)
password=$(gen_uuid)
client_json=$(make_trojan_client "$password" "$user")

source /usr/lib/kurovpn/subscription.sh 2>/dev/null || true

xray_add_client "trojan" "$client_json" || { echo "Error: failed to update Xray config."; exit 1; }
users_add "trojan" "$user" "$exp" "\"password\":\"$password\""

# Build subscription immediately
sub_build_user "$user" 2>/dev/null || true

link_ws="trojan://${password}@${domain}:443?path=/t&security=tls&type=ws&host=${domain}&sni=${domain}#${user}-Trojan-WS"
link_grpc="trojan://${password}@${domain}:443?mode=gun&security=tls&type=grpc&serviceName=trojan-grpc&host=${domain}&sni=${domain}#${user}-Trojan-gRPC"

clear
ui_card_begin "Xray Trojan Account"
ui_kv "Remarks"      "${user}"
ui_kv "Host/SNI"     "${domain}"
ui_kv "Password"     "${password}"
ui_kv "Expired"      "${exp}"
ui_kv "Port TLS"     "443"
ui_kv "Network"      "WS, gRPC"
ui_kv "Path WS"      "/trojan"
ui_kv "Subscription" "https://${domain}/sub/${user}"
ui_card_end

echo -e "\n  ${YELLOW}─── Client Import Links (Copy all at once to Happ/v2rayN) ───${NC}"
echo "$link_ws"
echo "$link_grpc"
echo -e "  ${YELLOW}─────────────────────────────────────────────────────────────${NC}\n"

echo -e "  ${GREEN}Subscription Link:${NC} https://${domain}/sub/${user}"
echo -e "  ${GREEN}Plaintext Link   :${NC} https://${domain}/sub/${user}.txt"

ui_qr "$link_ws" "Scan Trojan (WS TLS) QR Code"

CHATID=$(cat /etc/funny/.chatid 2>/dev/null)
KEY=$(cat /etc/funny/.keybot 2>/dev/null)
if [[ -n "$KEY" && -n "$CHATID" ]]; then
    curl -s --max-time 2 -d "chat_id=$CHATID&text=Trojan+$user+created+exp+$exp&parse_mode=html" \
        "https://api.telegram.org/bot$KEY/sendMessage" >/dev/null 2>&1
fi

ui_wait_key

