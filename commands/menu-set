#!/bin/bash
#
#  KUROVPN -- VPN Auto-Installer & Manager
#  https://github.com/imagi-tech/kurovpn
#
#  System management menu

source /usr/lib/kurovpn/ui.sh 2>/dev/null || true
ui_require_root

while true; do
clear
ui_header "System Settings" "Main › Settings"

ui_item 1  "Restart All Services"
ui_item 2  "Restart Xray"
ui_item 3  "Restart Nginx"
ui_item 4  "Restart SSH / Dropbear"
ui_item 5  "Speedtest"
ui_item 6  "HTOP (Process Monitor)"
ui_item 7  "Change Timezone"
ui_item 8  "Backup & Restore"
ui_item 9  "Domain / Cert Manager"
ui_item 10 "Bandwidth Monitor (vnstat)"
ui_item 11 "TCP BBR Speed Booster"
ui_item 12 "Uninstall KUROVPN"

echo ""
ui_footer
read -p "  Select: " opt

case "$opt" in
    1)
        systemctl restart xray xray.service 2>/dev/null
        systemctl restart nginx 2>/dev/null
        systemctl restart dropbear 2>/dev/null
        systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null
        systemctl restart wg-quick@wg0 2>/dev/null
        systemctl restart xl2tpd ipsec pptpd 2>/dev/null
        systemctl restart edu badvpn 2>/dev/null
        echo "  All services restarted."
        sleep 1
        ;;
    2) systemctl restart xray && echo "  Xray restarted." || echo "  Failed."; sleep 1 ;;
    3) systemctl restart nginx && echo "  Nginx restarted." || echo "  Failed."; sleep 1 ;;
    4) systemctl restart sshd 2>/dev/null || systemctl restart ssh; systemctl restart dropbear; echo "  SSH restarted."; sleep 1 ;;
    5) speedtest 2>/dev/null || speedtest-cli 2>/dev/null; echo ""; read -n1 -s -r -p "  Press any key..." ;;
    6) htop ;;
    7)
        echo ""
        echo "  Common timezones:"
        echo "    Asia/Jakarta   America/New_York"
        echo "    Asia/Singapore Europe/London"
        echo "    Asia/Tokyo     UTC"
        echo ""
        read -p "  Timezone: " tz
        [[ -n "$tz" ]] && { timedatectl set-timezone "$tz" 2>/dev/null && echo "  Timezone set → $tz" || echo "  Invalid timezone."; }
        sleep 2
        ;;
    8) bmenu ;;
    9) dm-menu ;;
    10) vnstat 2>/dev/null || echo "vnstat not installed"; echo ""; read -n1 -s -r -p "  Press any key..." ;;
    11) bbr ;;
    12) /usr/bin/uninstall; exit 0 ;;
    X|x) clear; exit 0 ;;
esac
done
